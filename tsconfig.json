  "compilerOptions": {
    "target": "ESNext", "module": "ESNext", "moduleResolution": "bundler",
    "lib": ["ESNext", "DOM", "DOM.Iterable"], "types": ["bun"],
    "strict": true, "noEmit": true, "skipLibCheck": true, "allowImportingTsExtensions": true,
    "jsx": "react-jsx"
